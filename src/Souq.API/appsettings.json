{
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Issuer": "Souq",
    "Audience": "SouqClient",
    "ExpiryMinutes": 15,
    "RefreshTokenDays": 30,
    "Key": ""
  },
  "Auth": {
    "RefreshCookie": { "Secure": true }
  },
  "RateLimiting": {
    "Auth": { "PermitLimit": 10, "WindowSeconds": 60 },
    "Refresh": { "PermitLimit": 30, "WindowSeconds": 60 },
    "CouponPreview": { "PermitLimit": 30, "WindowSeconds": 60 },
    "Basket": { "PermitLimit": 120, "WindowSeconds": 60 }
  },
  "Resend": {
    "From": "Marka <onboarding@resend.dev>"
  },
  "Brevo": {
    "SenderName": "Marka"
  },
  "App": {
    "FrontendUrl": "http://localhost:5173"
  },
  "Tenancy": {
    "PlatformHosts": [],
    "LocalDefaultTenant": "marka"
  },
  "Inventory": {
    "ReservationMinutes": 30,
    "SweepIntervalSeconds": 60
  },
  "Basket": {
    "GuestLifetimeDays": 30,
    "CustomerLifetimeDays": 180,
    "CleanupIntervalMinutes": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
