{
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Issuer": "Souq",
    "Audience": "SouqClient",
    "ExpiryMinutes": 15,
    "RefreshTokenDays": 30,
    "Key": ""
  },
  "Auth": {
    "RefreshCookie": {
      "Secure": true
    }
  },
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "Refresh": {
      "PermitLimit": 30,
      "WindowSeconds": 60
    },
    "CouponPreview": {
      "PermitLimit": 30,
      "WindowSeconds": 60
    },
    "Basket": {
      "PermitLimit": 120,
      "WindowSeconds": 60
    }
  },
  "Resend": {
    "From": "Souq <onboarding@resend.dev>"
  },
  "Brevo": {
    "SenderName": "Souq"
  },
  "App": {
    "FrontendUrl": "http://localhost:5173"
  },
  "Tenancy": {
    "PlatformHosts": []
  },
  "Inventory": {
    "ReservationMinutes": 30,
    "SweepIntervalSeconds": 60
  },
  "Basket": {
    "GuestLifetimeDays": 30,
    "CustomerLifetimeDays": 180,
    "CleanupIntervalMinutes": 60
  },
  "Search": {
    "Log": {
      "RetentionDays": 90,
      "PurgeIntervalMinutes": 360,
      "PurgeBatchSize": 5000,
      "WriteBatchMilliseconds": 2000
    }
  },
  "Notifications": {
    "DispatchIntervalSeconds": 5,
    "RetentionDays": 14
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Analytics": {
    "Events": {
      "Enabled": false,
      "VisitorIdentifierEnabled": false,
      "RetentionDays": 0,
      "LawfulBasis": "",
      "SessionIdleMinutes": 30,
      "WriteBatchMilliseconds": 2000,
      "RollupIntervalMinutes": 60,
      "PurgeIntervalMinutes": 360,
      "PurgeBatchSize": 5000
    }
  }
}
