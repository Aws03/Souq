<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <!-- لاحظ: لا أي ProjectReference هنا. Domain لا يعتمد على أحد. -->

  <!-- BaseEntity.CreatedAt/UpdatedAt بـ setter داخلي (internal) لا عام — يمنع أي
       كود خارجي من تزوير التواريخ، لكن يسمح لـ AppDbContext (طبقة Infrastructure)
       بضبطها عند الحفظ. هذا استثناء وحيد مقصود لحقل تقني بحت. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Souq.Infrastructure" />
  </ItemGroup>
  <!-- الاختبارات ترى Product.AddVariant (internal حتى نموذج الخيارات — V2) كي تثبت سلوك منتج بأكثر من متغيّر اليوم،
       دون أن يصير إنشاء متغيّر بلا خيارات سلوكاً متاحاً للتطبيق. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Souq.Domain.Tests" />
    <InternalsVisibleTo Include="Souq.Application.Tests" />
    <InternalsVisibleTo Include="Souq.IntegrationTests" />
  </ItemGroup>
</Project>
