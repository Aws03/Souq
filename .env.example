# انسخ هذا الملف إلى .env (لا يُرفع لـ git) واملأ القيم الحقيقية قبل
# docker compose up --build

# كلمة مرور مستخدم sa داخل حاوية SQL Server المُنشأة لهذه الحزمة (معزولة عن
# أي SQL Server آخر على جهازك). يجب أن تحقّق سياسة تعقيد SQL Server الافتراضية
# (8+ أحرف، حروف كبيرة وصغيرة وأرقام ورموز).
DB_SA_PASSWORD=Change_Me_123!

# اختياري (R-12): سلسلة اتصال تُستخدم لتطبيق الهجرات وحدها، كي لا يملك التطبيق أثناء التشغيل
# صلاحية تغيير المخطّط. اتركها فارغة في هذه الحزمة التجريبية (تُنشئ قاعدتها بنفسها فتحتاج sa).
# في نشر حقيقي: docs/07-SECURITY/DatabasePrivileges.md
DB_MIGRATIONS_CONNECTION=

# مفتاح توقيع JWT — نص عشوائي طويل (32 بايت على الأقل، وإلا يرفض الـ API الإقلاع)،
# لا تُعِد استخدام قيمة من بيئة أخرى. مثال لتوليده: openssl rand -base64 48
JWT_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET

# الدفع: ضع مفاتيح Stripe (مفاتيح وضع الاختبار sk_test_/pk_test_ للتجربة). بلا مفتاح يرفض
# الـ API الإقلاع — إلا إن ضبطت PAYMENTS_PROVIDER=Fake صراحةً: بوّابة تجريبية تعتبر كل دفع
# ناجحاً بلا مال (عرض توضيحي فقط، لا زبائن حقيقيون أبداً).
PAYMENTS_PROVIDER=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# حسابات Stripe خاصة بالمتاجر (المرحلة 11، اختياري): مفتاح تشفير مفاتيح المتاجر في القاعدة (AES-256-GCM)، base64
# لـ 32 بايت — مثال لتوليده: openssl rand -base64 32. بدونه لا يربط متجرٌ حسابه وتقبض كل المتاجر في حساب Stripe
# أعلاه. لا تغيّره بعد ربط متاجر (لن تُفكّ مفاتيحها) — التدوير في docs/09-OPERATIONS/DevelopmentGuide.md.
SECRETS_KEY=
# مفاتيح Stripe التجريبية لحسابات المتاجر مرفوضة في هذه الحزمة (Production). true يسمح بها صراحةً لعرض توضيحي
# فقط: بطاقات الاختبار لا تدفع مالاً حقيقياً.
PAYMENTS_ALLOW_TEST_MODE_STORE_ACCOUNTS=

# البريد (المرحلة 14): ترتيب الأولوية Resend ← Brevo ← Gmail. بلا أي منها يرفض الـ API الإقلاع في حزمة
# docker-compose (Production) — إلا إن ضبطت EMAIL_PROVIDER=Log صراحةً: لا تصل حينها أي رسالة (إعادة تعيين،
# تأكيد بريد، دعوة، تأكيد طلب) وتُسجَّل "لم يُرسَل" فقط. للعرض التوضيحي وحده.
EMAIL_PROVIDER=

# احصل على المفتاح من resend.com/api-keys — عنوان المرسِل الافتراضي
# (onboarding@resend.dev) يعمل فوراً بلا تحقّق نطاق، مخصّص للتطوير/الاختبار.
RESEND_API_KEY=

# اختياري: بديل Resend — يعمل فقط إن لم يُضبط RESEND_API_KEY أعلاه.
# احصل على المفتاح من app.brevo.com → SMTP & API → API Keys.
BREVO_API_KEY=

# اختياري: بديل Resend/Brevo عبر SMTP جيميل (بلا أيّها انظر EMAIL_PROVIDER أعلاه).
# للحصول على كلمة مرور تطبيق (App Password) من جيميل:
#   Google Account → Security → 2-Step Verification → App passwords
#   أنشئ كلمة مرور تطبيق جديدة باسم "Mail" والصقها هنا (16 حرفاً بلا مسافات).
# ملاحظة: كلمات مرور التطبيقات تتطلّب تفعيل التحقّق بخطوتين على الحساب أولاً.
# اتركه فارغاً إن لم تستخدم جيميل: أي قيمة هنا — ولو كانت نصّاً توضيحياً — تختار جيميل مزوّداً للبريد وتُبطل الفشل
# الآمن المبكّر، فيقلع الـ API ثم تموت كل رسالة بعد ثماني محاولات بلا أن يلاحظ أحد (R-22).
GMAIL_APP_PASSWORD=
GMAIL_USERNAME=
# اختياري: عنوان مرسِل Brevo (وإلا يُستخدم GMAIL_USERNAME).
BREVO_SENDER_EMAIL=

# منفذ SMTP: الافتراضي 587 (STARTTLS). بعض مزوّدي الإنترنت يحجبون 587 —
# إن رأيت "Network is unreachable" في سجلّ الخادم فاستخدم 465 (TLS ضمني).
GMAIL_SMTP_PORT=587

# رابط الواجهة المُستخدَم داخل رسائل البريد (روابط إعادة التعيين) — اتركه على
# القيمة الافتراضية إلا إن نشرت الواجهة على نطاق مختلف.
# رابط الواجهة داخل رسائل البريد (روابط إعادة التعيين). ليعمل الرابط من أي
# جهاز على شبكتك المحلية استخدم عنوان جهازك (اكتشفه: ipconfig getifaddr en0)
# بالمنفذ 8081 المنشور للواجهة، مثال: http://<عنوان-جهازك>:8081
# اتركه فارغاً للتطوير المحلي (يرجع للافتراضي http://localhost:5173).
FRONTEND_URL=http://localhost:8081

# أول مدير في Production: بلا هذين لا يُنشأ أي مدير (لا كلمة مرور افتراضية منشورة).
# كلمة المرور 12 حرفاً على الأقل. احذفهما بعد أول إقلاع ناجح.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# بيانات العرض: الكتالوج التجريبي ومظهر المتجر الافتراضي وبيانات تواصله. اتركه فارغاً — لا تُبذَر خارج التطوير
# والاختبار. true لعرض توضيحي فقط؛ قاعدة زبون حقيقي يجب أن تبدأ نظيفة.
SEED_DEMO_DATA=

# تعدّد المتاجر: المتجر يُحدَّد من عنوان الموقع (المضيف) فقط. هذه المضيفات تُربط بالمتجر الافتراضي
# عند الإقلاع (مفصولة بفواصل) — localhost كي تعمل الحزمة محلياً. مضيف منطقة المنصّة (لوحة مالك المنصّة)
# منفصل: admin.localhost محلياً، ونطاقك الحقيقي (مثل admin.example.com) في النشر.
DEFAULT_TENANT_HOSTS=localhost
PLATFORM_HOST=admin.localhost

# مالك المنصّة (يدخل على PLATFORM_HOST): بلا هذين لا يُنشأ أي حساب منصّة. 12 حرفاً على الأقل.
SEED_PLATFORM_OWNER_EMAIL=
SEED_PLATFORM_OWNER_PASSWORD=

# الشبكات الموثوقة لترويسات X-Forwarded-* (وكيل Nginx داخل Docker). لا تضع 0.0.0.0/0 أبداً.
TRUSTED_PROXY_NETWORKS=172.16.0.0/12
