# انسخ هذا الملف إلى .env (لا يُرفع لـ git) واملأ القيم الحقيقية قبل
# docker compose up --build

# كلمة مرور مستخدم sa داخل حاوية SQL Server المُنشأة لهذه الحزمة (معزولة عن
# أي SQL Server آخر على جهازك). يجب أن تحقّق سياسة تعقيد SQL Server الافتراضية
# (8+ أحرف، حروف كبيرة وصغيرة وأرقام ورموز).
DB_SA_PASSWORD=Change_Me_123!

# مفتاح توقيع JWT — نص عشوائي طويل (32 حرفاً على الأقل)، لا تُعِد استخدام قيمة
# من بيئة أخرى.
JWT_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET

# اختياري: بلا هذه المفاتيح يعمل الدفع تلقائياً عبر بوّابة تجريبية (FakePaymentService).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
