# انسخ هذا الملف إلى .env (لا يُرفع لـ git) واملأ القيم الحقيقية قبل
# docker compose up --build

# كلمة مرور مستخدم sa داخل حاوية SQL Server المُنشأة لهذه الحزمة (معزولة عن
# أي SQL Server آخر على جهازك). يجب أن تحقّق سياسة تعقيد SQL Server الافتراضية
# (8+ أحرف، حروف كبيرة وصغيرة وأرقام ورموز).
DB_SA_PASSWORD=Change_Me_123!

# مفتاح توقيع JWT — نص عشوائي طويل (32 حرفاً على الأقل)، لا تُعِد استخدام قيمة
# من بيئة أخرى.
JWT_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET

# اختياري: بلا هذه المفاتيح يعمل الدفع تلقائياً عبر بوّابة تجريبية (FakePaymentService).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# اختياري: بلا RESEND_API_KEY (ولا GMAIL_APP_PASSWORD أدناه) يعمل البريد
# تلقائياً عبر ConsoleEmailService (رابط إعادة تعيين كلمة المرور يُطبَع في
# سجلّ الخادم بدل إرسال بريد حقيقي). Resend يتقدّم على Gmail إن ضُبط كلاهما.
# احصل على المفتاح من resend.com/api-keys — عنوان المرسِل الافتراضي
# (onboarding@resend.dev) يعمل فوراً بلا تحقّق نطاق، مخصّص للتطوير/الاختبار.
RESEND_API_KEY=

# اختياري: بلا GMAIL_APP_PASSWORD (ولا RESEND_API_KEY أعلاه) يعمل البريد
# تلقائياً عبر ConsoleEmailService.
# للحصول على كلمة مرور تطبيق (App Password) من جيميل:
#   Google Account → Security → 2-Step Verification → App passwords
#   أنشئ كلمة مرور تطبيق جديدة باسم "Mail" والصقها هنا (16 حرفاً بلا مسافات).
# ملاحظة: كلمات مرور التطبيقات تتطلّب تفعيل التحقّق بخطوتين على الحساب أولاً.
GMAIL_APP_PASSWORD=your-16-char-app-password
GMAIL_USERNAME=aws.03.dev@gmail.com

# منفذ SMTP: الافتراضي 587 (STARTTLS). بعض مزوّدي الإنترنت يحجبون 587 —
# إن رأيت "Network is unreachable" في سجلّ الخادم فاستخدم 465 (TLS ضمني).
GMAIL_SMTP_PORT=587

# رابط الواجهة المُستخدَم داخل رسائل البريد (روابط إعادة التعيين) — اتركه على
# القيمة الافتراضية إلا إن نشرت الواجهة على نطاق مختلف.
# رابط الواجهة داخل رسائل البريد (روابط إعادة التعيين). ليعمل الرابط من أي
# جهاز على شبكتك المحلية استخدم عنوان جهازك (اكتشفه: ipconfig getifaddr en0)
# بالمنفذ 8081 المنشور للواجهة، مثال: http://192.168.1.34:8081
# اتركه فارغاً للتطوير المحلي (يرجع للافتراضي http://localhost:5173).
FRONTEND_URL=http://192.168.1.34:8081
