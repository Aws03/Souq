# انسخ هذا الملف إلى .env (لا يُرفع لـ git) واملأ القيم الحقيقية قبل
# docker compose up --build

# كلمة مرور مستخدم sa داخل حاوية SQL Server المُنشأة لهذه الحزمة (معزولة عن
# أي SQL Server آخر على جهازك). يجب أن تحقّق سياسة تعقيد SQL Server الافتراضية
# (8+ أحرف، حروف كبيرة وصغيرة وأرقام ورموز).
DB_SA_PASSWORD=Change_Me_123!

# مفتاح توقيع JWT — نص عشوائي طويل (32 بايت على الأقل، وإلا يرفض الـ API الإقلاع)،
# لا تُعِد استخدام قيمة من بيئة أخرى. مثال لتوليده: openssl rand -base64 48
JWT_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET

# الدفع: ضع مفاتيح Stripe (مفاتيح وضع الاختبار sk_test_/pk_test_ للتجربة). بلا مفتاح يرفض
# الـ API الإقلاع — إلا إن ضبطت PAYMENTS_PROVIDER=Fake صراحةً: بوّابة تجريبية تعتبر كل دفع
# ناجحاً بلا مال (عرض توضيحي فقط، لا زبائن حقيقيون أبداً).
PAYMENTS_PROVIDER=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# اختياري: ترتيب أولوية البريد هو Resend ← Brevo ← Gmail ← ConsoleEmailService
# (بلا أي منها يُطبَع رابط إعادة التعيين في سجلّ الخادم بدل إرسال بريد حقيقي).
# احصل على المفتاح من resend.com/api-keys — عنوان المرسِل الافتراضي
# (onboarding@resend.dev) يعمل فوراً بلا تحقّق نطاق، مخصّص للتطوير/الاختبار.
RESEND_API_KEY=

# اختياري: بديل Resend — يعمل فقط إن لم يُضبط RESEND_API_KEY أعلاه.
# احصل على المفتاح من app.brevo.com → SMTP & API → API Keys.
BREVO_API_KEY=

# اختياري: بلا GMAIL_APP_PASSWORD (ولا RESEND_API_KEY/BREVO_API_KEY أعلاه)
# يعمل البريد تلقائياً عبر ConsoleEmailService.
# للحصول على كلمة مرور تطبيق (App Password) من جيميل:
#   Google Account → Security → 2-Step Verification → App passwords
#   أنشئ كلمة مرور تطبيق جديدة باسم "Mail" والصقها هنا (16 حرفاً بلا مسافات).
# ملاحظة: كلمات مرور التطبيقات تتطلّب تفعيل التحقّق بخطوتين على الحساب أولاً.
GMAIL_APP_PASSWORD=your-16-char-app-password
GMAIL_USERNAME=
# اختياري: عنوان مرسِل Brevo (وإلا يُستخدم GMAIL_USERNAME).
BREVO_SENDER_EMAIL=

# منفذ SMTP: الافتراضي 587 (STARTTLS). بعض مزوّدي الإنترنت يحجبون 587 —
# إن رأيت "Network is unreachable" في سجلّ الخادم فاستخدم 465 (TLS ضمني).
GMAIL_SMTP_PORT=587

# رابط الواجهة المُستخدَم داخل رسائل البريد (روابط إعادة التعيين) — اتركه على
# القيمة الافتراضية إلا إن نشرت الواجهة على نطاق مختلف.
# رابط الواجهة داخل رسائل البريد (روابط إعادة التعيين). ليعمل الرابط من أي
# جهاز على شبكتك المحلية استخدم عنوان جهازك (اكتشفه: ipconfig getifaddr en0)
# بالمنفذ 8081 المنشور للواجهة، مثال: http://<عنوان-جهازك>:8081
# اتركه فارغاً للتطوير المحلي (يرجع للافتراضي http://localhost:5173).
FRONTEND_URL=http://localhost:8081

# أول مدير في Production: بلا هذين لا يُنشأ أي مدير (لا كلمة مرور افتراضية منشورة).
# كلمة المرور 12 حرفاً على الأقل. احذفهما بعد أول إقلاع ناجح.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
